<Window x:Class="LMUOverlay.Views.PiperGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation Piper TTS — Douze Assistance"
        Width="620" Height="640"
        MinWidth="480" MinHeight="400"
        Background="#FF0B0B0B"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#FF0E0E0E"
                BorderBrush="#FF1E1E1E" BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel>
                <TextBlock Text="INSTALLATION PIPER TTS"
                           FontFamily="Segoe UI Semibold" FontSize="12" FontWeight="Bold"
                           Foreground="#FF9146FF"/>
                <TextBlock Text="Moteur de synthèse vocale locale pour Douze Assistance"
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#FF525252" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Contenu scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,8">
            <TextBlock x:Name="TbGuide"
                       FontFamily="Consolas" FontSize="11"
                       Foreground="#FFD0D0D0"
                       TextWrapping="Wrap"
                       LineHeight="18"/>
        </ScrollViewer>

        <!-- Pied de page -->
        <Border Grid.Row="2" Background="#FF0E0E0E"
                BorderBrush="#FF1E1E1E" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Button x:Name="BtnClose" Content="FERMER"
                    Click="OnClose"
                    HorizontalAlignment="Right"
                    Background="#FF1C1C1C" Foreground="#FFA3A3A3"
                    BorderBrush="#FF2A2A2A" BorderThickness="1"
                    FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                    Padding="16,6" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="#FF1C1C1C"/>
                        <Setter Property="Foreground"      Value="#FFA3A3A3"/>
                        <Setter Property="BorderBrush"     Value="#FF2A2A2A"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontFamily"      Value="Segoe UI"/>
                        <Setter Property="FontSize"        Value="10"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="Padding"         Value="16,6"/>
                        <Setter Property="Cursor"          Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"  Value="#FF252525"/>
                                            <Setter Property="BorderBrush" Value="#FF383838"/>
                                            <Setter Property="Foreground"  Value="#FFF5F5F5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>
